# Copy to .env and fill in. Never commit .env.

# ---- core -------------------------------------------------------------------
DEBUG=0                       # 1 only on your own computer
SECRET_KEY=                   # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
ADMIN_URL=admin/              # pick something hard to guess, e.g. a random word + digits

# ---- database (MariaDB 10.5+ / MySQL 8+) ------------------------------------
DB_NAME=nitsdate
DB_USER=nitsdate
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60            # keep connections open between requests (0 locally)

# ---- Google sign-in (https://console.cloud.google.com/apis/credentials) -----
# Authorized redirect URI: https://your-domain.example/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty = any Google account. nits.ac.in = only @nits.ac.in and @<dept>.nits.ac.in
ALLOWED_EMAIL_DOMAIN=

# ---- admins -----------------------------------------------------------------
# Comma-separated emails that are admins (or use: python manage.py make_admin EMAIL)
ADMIN_EMAILS=

# ---- uploaded photos ----------------------------------------------------------
# local = files on this server (MEDIA_ROOT); s3 = an S3-compatible private bucket
MEDIA_STORAGE=local
MEDIA_ROOT=
# For MEDIA_STORAGE=s3, e.g. Cloudflare R2:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
# or Oracle Object Storage:
#   S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com   S3_REGION=<region>
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- HTTPS ------------------------------------------------------------------
SECURE_HSTS_SECONDS=3600      # raise to 31536000 once the final domain is settled

# ---- testing only -------------------------------------------------------------
# Password-less "pick a test user" login. Keep 0 once real students use the site.
DEV_LOGIN=0

# Shown on /privacy/ and /terms/ for questions and account-deletion requests (empty hides it)
CONTACT_EMAIL=
